<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+: set the platform splash attributes directly so the system splash is pure black
         (matching the Dot background) with no icon; the Tsuzuki startup animation draws the logo. -->
    <style name="Theme.Tachiyomi.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash</item>
        <item name="android:windowBackground">@color/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Tachiyomi</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
