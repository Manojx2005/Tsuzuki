import kotlin.Boolean;

CREATE TABLE extension_store(
    index_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    badge_label TEXT NOT NULL,
    signing_key TEXT NOT NULL,
    contact_website TEXT NOT NULL,
    contact_discord TEXT,
    is_legacy INTEGER AS Boolean NOT NULL,
    is_novel INTEGER AS Boolean NOT NULL DEFAULT 0,
    extension_list_url TEXT,
    media TEXT NOT NULL DEFAULT 'manga' CHECK (media IN ('novel', 'manga', 'anime'))
);

get:
SELECT index_url, name, badge_label, signing_key, contact_website, contact_discord,
    is_legacy, is_novel, extension_list_url
FROM extension_store
WHERE index_url = :indexUrl AND media != 'anime';

getAll:
SELECT index_url, name, badge_label, signing_key, contact_website, contact_discord,
    is_legacy, is_novel, extension_list_url
FROM extension_store WHERE media != 'anime';

getCount:
SELECT COUNT(*)
FROM extension_store WHERE media != 'anime';

upsert:
INSERT INTO extension_store(index_url, name, badge_label, signing_key, contact_website, contact_discord,
    is_legacy, is_novel, extension_list_url, media)
VALUES (:indexUrl, :name, :badgeLabel, :signingKey, :contactWebsite, :contactDiscord,
    :isLegacy, :isNovel, :extensionListUrl, CASE WHEN :isNovel THEN 'novel' ELSE 'manga' END)
ON CONFLICT(index_url)
DO UPDATE
SET
    name = :name,
    badge_label = :badgeLabel,
    signing_key =: signingKey,
    contact_website = :contactWebsite,
    contact_discord = :contactDiscord,
    is_legacy = :isLegacy,
    is_novel = :isNovel,
    extension_list_url = :extensionListUrl,
    media = excluded.media
WHERE index_url = :indexUrl AND extension_store.media != 'anime';

delete:
DELETE FROM extension_store
WHERE index_url = :indexUrl AND media != 'anime';

getAnimeStores:
SELECT index_url, name FROM extension_store WHERE media = 'anime' ORDER BY name, index_url;

insertAnimeStore:
INSERT INTO extension_store(index_url, name, badge_label, signing_key, contact_website, is_legacy, media)
VALUES (:indexUrl, :name, 'Anime', '', '', 1, 'anime');

deleteAnimeStore:
DELETE FROM extension_store WHERE index_url = :indexUrl AND media = 'anime';
