CREATE TABLE categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    content_type INTEGER NOT NULL DEFAULT 0
);

-- Insert system category
INSERT OR IGNORE INTO categories(_id, name, sort, flags, content_type) VALUES (0, "", -1, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT *
FROM categories
WHERE _id = :id
LIMIT 1;

getCategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type
FROM categories
ORDER BY sort;

getCategoriesWithBookCounts:
SELECT
    C._id AS id,
    C.name,
    C.sort AS `order`,
    C.flags,
    C.content_type,
    count(M._id) AS book_count
FROM categories C
LEFT JOIN mangas_categories MC ON MC.category_id = C._id
LEFT JOIN mangas M ON M._id = MC.manga_id
    AND M.favorite = 1
    AND (C.content_type = 0 OR (C.content_type = 1 AND M.is_novel = 0) OR (C.content_type = 2 AND M.is_novel = 1))
WHERE C._id > 0
GROUP BY C._id
ORDER BY C.sort;

getCategoriesByMangaId:
SELECT
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- Batch fetch categories for multiple manga IDs - optimized for duplicate detection
getCategoriesByMangaIds:
SELECT
MC.manga_id,
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.content_type
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id IN :mangaIds
ORDER BY MC.manga_id, C.sort;

getCategoriesByContentType:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
content_type
FROM categories
WHERE content_type = :contentType OR content_type = 0
ORDER BY sort;

insert:
INSERT INTO categories(name, sort, flags, content_type)
VALUES (:name, :order, :flags, :contentType);

delete:
DELETE FROM categories
WHERE _id = :categoryId;

updateName:
UPDATE categories
SET name = :name
WHERE _id = :categoryId;

updateOrder:
UPDATE categories
SET sort = :order
WHERE _id = :categoryId;

updateFlags:
UPDATE categories
SET flags = :flags
WHERE _id = :categoryId;

updateAllFlags:
UPDATE categories SET
flags = coalesce(:flags, flags);

selectLastInsertedRowId:
SELECT last_insert_rowid();
