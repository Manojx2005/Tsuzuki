CREATE TABLE anime_sources(
    _id INTEGER NOT NULL PRIMARY KEY,
    lang TEXT NOT NULL,
    name TEXT NOT NULL
);

getById:
SELECT * FROM anime_sources WHERE _id = :id;

getAll:
SELECT * FROM anime_sources ORDER BY _id;

upsert:
INSERT INTO anime_sources(_id, lang, name) VALUES (:id, :lang, :name)
ON CONFLICT(_id) DO UPDATE SET lang = excluded.lang, name = excluded.name;
